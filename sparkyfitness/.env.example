# Insert your domain and certificate resolver here.
DOMAIN=
CERTRESOLVER=
# For example:
# DOMAIN=akanagala.com
# CERTRESOLVER=porkbun

# --- PostgreSQL Database ---
SPARKY_FITNESS_DB_NAME=sparkyfitness_db
SPARKY_FITNESS_DB_USER=sparky
SPARKY_FITNESS_DB_PASSWORD=
# Application DB user with limited privileges
SPARKY_FITNESS_APP_DB_USER=sparky_app
SPARKY_FITNESS_APP_DB_PASSWORD=

# --- Security (required) ---
# 64-character hex string. Generate with: openssl rand -hex 32
SPARKY_FITNESS_API_ENCRYPTION_KEY=
# Signs sessions / 2FA. Generate with: openssl rand -hex 32
# WARNING: changing this after users enable 2FA locks them out.
BETTER_AUTH_SECRET=

# --- OIDC single sign-on via Authelia ---
# The PLAINTEXT client secret. Authelia stores the HASHED form (see
# authelia/configuration.yaml). Generate the pair on the LXC with:
#   docker compose exec authelia authelia crypto hash generate pbkdf2 \
#     --variant sha512 --random --random.length 72 --random.charset rfc3986
SPARKY_FITNESS_OIDC_CLIENT_SECRET=
# Defaults below are set in docker-compose.yaml; override here only if needed.
# SPARKY_FITNESS_OIDC_AUTH_ENABLED=true
# SPARKY_FITNESS_OIDC_PROVIDER_SLUG=authelia
# SPARKY_FITNESS_OIDC_PROVIDER_NAME=Authelia
# SPARKY_FITNESS_OIDC_CLIENT_ID=sparkyfitness
# SPARKY_FITNESS_OIDC_ADMIN_GROUP=admins
# SPARKY_FITNESS_OIDC_AUTO_REGISTER=true
# Keep email/password login as a fail-safe during rollout; set false once OIDC works.
# SPARKY_FITNESS_FORCE_EMAIL_LOGIN=true

# --- Optional ---
# INFO, DEBUG, WARN, ERROR
SPARKY_FITNESS_LOG_LEVEL=ERROR
# Set to true after creating your account to stop new registrations
SPARKY_FITNESS_DISABLE_SIGNUP=false
# Email of the user to auto-grant admin privileges
SPARKY_FITNESS_ADMIN_EMAIL=
